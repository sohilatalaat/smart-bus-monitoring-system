    {
        "id": "4396f8850c97e0d9",
        "type": "ui_template",
        "z": "738edf5cf71ab6b3",
        "group": "40b1f3b75b2c0820",
        "name": "fleet table",
        "order": 1,
        "width": "6",
        "height": "6",
        "format": "<style>\n.ftw{width:100%;overflow-x:auto}\n.ft{width:100%;border-collapse:collapse;font-family:inherit;color:inherit;table-layout:fixed}\n.ft th{text-align:left;padding:4px 3px;font-size:11px;opacity:.6;border-bottom:1px solid rgba(128,128,128,.4);white-space:nowrap}\n.ft td{padding:8px 3px;font-size:13px;border-bottom:1px solid rgba(128,128,128,.18);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.pill{display:inline-block;padding:2px 8px;border-radius:11px;font-size:10px;color:#fff}\n.bar{height:8px;border-radius:4px;background:rgba(128,128,128,.28);overflow:hidden}\n.fill{height:8px;border-radius:4px;transition:width .5s}\n.cd{font-weight:600;font-variant-numeric:tabular-nums}\n.empty{opacity:.5;padding:14px 4px;font-size:13px}\n</style>\n\n<div class=\"ftw\">\n<table class=\"ft\">\n  <colgroup>\n    <col style=\"width:17%\"><col style=\"width:20%\"><col style=\"width:19%\">\n    <col style=\"width:14%\"><col style=\"width:14%\"><col style=\"width:16%\">\n  </colgroup>\n  <tr>\n    <th>Bus</th><th>Status</th><th>Stop</th><th>Time</th><th>Free</th><th>Load</th>\n  </tr>\n  <tr ng-repeat=\"b in msg.payload\">\n    <td><b>{{b.bus_id}}</b></td>\n    <td><span class=\"pill\" ng-style=\"{'background':b.color}\">{{b.status}}</span></td>\n    <td>Station {{b.station}}</td>\n    <td class=\"cd\">{{b.count}}s</td>\n    <td>{{b.available}}/{{b.total}}</td>\n    <td>\n      <div class=\"bar\">\n        <div class=\"fill\" ng-style=\"{'width':b.percent+'%','background':b.loadColor}\"></div>\n      </div>\n    </td>\n  </tr>\n</table>\n</div>\n\n<div class=\"empty\" ng-if=\"!msg.payload || msg.payload.length==0\">Waiting for buses to publish...</div>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
