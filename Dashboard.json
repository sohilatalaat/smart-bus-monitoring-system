    {
        "id": "6b0d9023fac99beb",
        "type": "function",
        "z": "738edf5cf71ab6b3",
        "name": "store bus state",
        "func": "var p = msg.payload;\n\nif (typeof p === 'string') {\n    try { p = JSON.parse(p); } catch (e) { node.warn('bad json'); return null; }\n}\nif (!p || !p.bus_id) { return null; }\n\nvar buses = flow.get('buses') || {};\n\nvar available = Number(p.available || 0);\nvar occupied = Number(p.occupied || 0);\nvar total = Number(p.total || (available + occupied));\nvar percent = total > 0 ? Math.round(occupied * 100 / total) : 0;\n\nbuses[p.bus_id] = {\n    bus_id: p.bus_id,\n    bus_num: Number(p.bus_num || 0),\n    status: String(p.status || 'Unknown'),\n    station: Number(p.station || 0),\n    eta: Number(p.eta || 0),\n    leave_in: Number(p.leave_in || 0),\n    available: available,\n    occupied: occupied,\n    total: total,\n    percent: percent,\n    t: Date.now()\n};\n\nflow.set('buses', buses);\n\nmsg.payload = buses[p.bus_id];\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
        "y": 220,
        "wires": [
            [
                "34234309b559061f"
            ]
        ]
    },
    {
        "id": "34234309b559061f",
        "type": "function",
        "z": "738edf5cf71ab6b3",
        "name": "chart feed",
        "func": "return {\n    topic: msg.payload.bus_id,\n    payload: msg.payload.percent\n};",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
