        "name": "bus 1 card",
        "order": 1,
        "width": "4",
        "height": "7",
        "format": "<style>\n.bc{font-variant-numeric:tabular-nums}\n.bc .top{display:flex;justify-content:space-between;align-items:center}\n.bc .id{font-size:19px;font-weight:700}\n.bc .st{padding:3px 9px;border-radius:11px;color:#fff;font-size:10px}\n.bc .lbl{font-size:10px;opacity:.55;letter-spacing:1.2px;margin-top:10px}\n.bc .big{font-size:30px;font-weight:700;line-height:1.1}\n.bc .r{display:flex;justify-content:space-between;font-size:12.5px;padding:5px 0;border-bottom:1px solid rgba(128,128,128,.18)}\n.dialwrap{display:flex;align-items:center;gap:12px;margin-top:12px}\n.dial{width:74px;height:74px;border-radius:50%;flex:none;display:flex;align-items:center;justify-content:center}\n.dial .hole{width:56px;height:56px;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;font-size:15px;font-weight:700}\n.dlbl{font-size:11px;opacity:.6;line-height:1.5}\n</style>\n\n<div class=\"bc\" ng-if=\"msg.payload\">\n  <div class=\"top\">\n    <span class=\"id\">{{msg.payload.bus_id}}</span>\n    <span class=\"st\" ng-style=\"{'background':msg.payload.color}\">{{msg.payload.status}}</span>\n  </div>\n\n  <div class=\"lbl\">{{msg.payload.label}}</div>\n  <div class=\"big\">{{msg.payload.count}}s</div>\n\n  <div class=\"r\" style=\"margin-top:8px\"><span>Next stop</span><b>Station {{msg.payload.station}}</b></div>\n  <div class=\"r\"><span>Free seats</span><b>{{msg.payload.available}} / {{msg.payload.total}}</b></div>\n  <div class=\"r\"><span>Occupied</span><b>{{msg.payload.occupied}}</b></div>\n\n  <div class=\"dialwrap\">\n    <div class=\"dial\" ng-style=\"{'background':'conic-gradient('+msg.payload.loadColor+' 0% '+msg.payload.percent+'%, rgba(128,128,128,.22) '+msg.payload.percent+'% 100%)'}\">\n      <div class=\"hole\">{{msg.payload.percent}}%</div>\n    </div>\n    <div class=\"dlbl\">Occupancy<br>{{msg.payload.occupied}} of {{msg.payload.total}} seats</div>\n  </div>\n</div>\n\n<div ng-if=\"!msg.payload\" style=\"opacity:.5;font-size:13px\">No data yet</div>",
