    {
        "id": "341bbd5bb709447d",
        "type": "ui_template",
        "z": "738edf5cf71ab6b3",
        "group": "5e03142bdd114205",
        "name": "station boards",
        "order": 1,
        "width": "6",
        "height": "6",
        "format": "<style>\n.sw{display:flex;flex-direction:column;gap:8px}\n.sc{border:1px solid rgba(128,128,128,.3);border-radius:7px;padding:8px 10px}\n.sh{font-size:10px;opacity:.55;letter-spacing:1.2px;margin-bottom:4px}\n.row{display:flex;justify-content:space-between;align-items:baseline;gap:8px}\n.arr{color:#2e9e4f;font-weight:700;font-size:14px}\n.non{opacity:.5;font-size:13px}\n.sub{font-size:12px;opacity:.85;font-variant-numeric:tabular-nums}\n.nx{font-size:12px;margin-top:5px;padding-top:5px;border-top:1px solid rgba(128,128,128,.22);opacity:.9}\n</style>\n\n<div class=\"sw\">\n  <div class=\"sc\" ng-repeat=\"s in msg.payload\">\n    <div class=\"sh\">STATION {{s.station}}</div>\n\n    <div class=\"row\" ng-if=\"s.at\">\n      <span class=\"arr\">{{s.at.bus_id}} ARRIVED</span>\n      <span class=\"sub\">departs in {{s.at.count}}s</span>\n    </div>\n    <div class=\"sub\" ng-if=\"s.at\">{{s.at.available}} of {{s.at.total}} seats free</div>\n\n    <div class=\"non\" ng-if=\"!s.at\">No bus at stop</div>\n\n    <div class=\"nx\" ng-if=\"s.next\">Next: <b>{{s.next.bus_id}}</b> in {{s.next.count}}s</div>\n    <div class=\"nx\" ng-if=\"!s.next\">No bus incoming</div>\n  </div>\n</div>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
