    {
        "id": "f175151db855cbc9",
        "type": "function",
        "z": "738edf5cf71ab6b3",
        "name": "render dashboard",
        "func": "var buses = flow.get('buses') || {};\nvar now = Date.now();\nvar list = [];\n\nObject.keys(buses).forEach(function (k) {\n    var s = buses[k];\n    var age = Math.floor((now - s.t) / 1000);\n\n    var b = {\n        bus_id: s.bus_id,\n        bus_num: s.bus_num,\n        status: s.status,\n        station: s.station,\n        available: s.available,\n        occupied: s.occupied,\n        total: s.total,\n        percent: s.percent,\n        count: 0\n    };\n\n    if (age > 20) {\n        b.status = 'Offline';\n        b.count = 0;\n    } else if (s.status === 'Arrived') {\n        b.count = Math.max(0, s.leave_in - age);\n    } else {\n        b.count = Math.max(0, s.eta - age);\n    }\n\n    b.color = b.status === 'Arrived' ? '#2e9e4f' : (b.status === 'Offline' ? '#8a8a8a' : '#2a6ebb');\n    b.loadColor = b.percent > 80 ? '#ca3838' : (b.percent > 50 ? '#e6a700' : '#00b050');\n    b.label = b.status === 'Arrived' ? 'DEPARTING IN' : 'ARRIVING IN';\n\n    list.push(b);\n});\n\nlist.sort(function (a, b) { return a.bus_num - b.bus_num; });\n\nvar stations = [];\nfor (var s = 1; s <= 3; s++) {\n    var at = null;\n    var nxt = null;\n\n    list.forEach(function (b) {\n        if (b.station !== s || b.status === 'Offline') { return; }\n        if (b.status === 'Arrived') { at = b; }\n        if (b.status === 'Moving') {\n            if (nxt === null || b.count < nxt.count) { nxt = b; }\n        }\n    });\n\n    stations.push({ station: s, at: at, next: nxt });\n}\n\nfunction find(num) {\n    var found = null;\n    list.forEach(function (b) { if (b.bus_num === num) { found = b; } });\n    return found;\n}\n\nreturn [\n    { payload: list },\n    { payload: stations },\n    { payload: find(1) },\n    { payload: find(2) },\n    { payload: find(3) }\n];",
        "outputs": 5,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 350,
        "y": 360,
